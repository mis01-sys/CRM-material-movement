<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101c2c">
    <title><%= title %> · AAA Fastener Material Movement Portal</title>
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body class="workspace">
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand-lockup" href="<%= workspace.base %>"><span class="brand-mark">A</span><span>AAA Fastener<span class="brand-light"> Portal</span></span></a>
            <div class="sidebar-caption">WORKSPACE</div>
            <nav class="main-nav" aria-label="Main navigation">
                <% nav.forEach((item) => { %>
                    <a class="nav-link<%= item.active ? ' active' : '' %>" href="<%= workspace.base %>/<%= item.key === 'overview' ? '' : item.key %>">
                        <span class="nav-icon" aria-hidden="true"><%= ({ overview: "◫", orders: "▤", customers: "♙", items: "▦", stages: "⟳", ledger: "↗", users: "♧", settings: "⚙" })[item.key] %></span>
                        <span><%= item.title === "Overview" ? `${user.role} dashboard` : item.title %></span>
                    </a>
                <% }) %>
            </nav>
            <div class="sidebar-bottom">
                <div class="sidebar-note"><span class="status-dot"></span><span>Workspace is up to date</span></div>
                <div class="profile">
                    <span class="avatar"><%= user.username.charAt(0).toUpperCase() %></span>
                    <span class="profile-info"><strong><%= user.username %></strong><small><%= user.role %></small></span>
                    <form action="/logout" method="post"><button class="icon-button" title="Sign out" aria-label="Sign out">↗</button></form>
                </div>
            </div>
        </aside>
        <main class="main-panel">
            <header class="topbar">
                <div class="breadcrumb"><span>AAA Fastener Portal</span><span class="breadcrumb-slash">/</span><strong><%= title %></strong></div>
                <div class="topbar-right"><span class="today-label"><%= new Date().toLocaleDateString() %></span><span class="role-pill"><%= user.role %></span><form action="/logout" method="post"><button class="icon-button" title="Sign out" aria-label="Sign out">↗</button></form></div>
            </header>
            <section class="page-content">
                <% if (message) { %><p class="notice success-notice"><%= message %></p><% } %>
                <% if (error) { %><p class="notice error-notice" role="alert"><%= error %></p><% } %>
                <%- include(`pages/${section}`) %>
            </section>
        </main>
    </div>
    <script src="/scripts/pages.js" defer></script>
</body>
</html>
