<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#101c2c">
    <title><%= record ? "Edit" : "Create" %> <%= section %> · AAA Fastener Material Movement Portal</title>
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body class="workspace">
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand-lockup" href="<%= workspace.base %>"><span class="brand-mark">A</span><span>AAA Fastener<span class="brand-light"> Portal</span></span></a>
            <div class="sidebar-caption">WORKSPACE</div>
            <nav class="main-nav" aria-label="Main navigation">
                <% nav.forEach((item) => { %><a class="nav-link" href="<%= workspace.base %>/<%= item.key === 'overview' ? '' : item.key %>"><span class="nav-icon" aria-hidden="true"><%= ({ overview: "◫", orders: "▤", customers: "♙", items: "▦", stages: "⟳", ledger: "↗", users: "♧", settings: "⚙" })[item.key] %></span><span><%= item.key === "overview" ? `${user.role} dashboard` : item.title %></span></a><% }) %>
            </nav>
        </aside>
        <main class="main-panel">
            <header class="topbar"><div class="breadcrumb"><a href="<%= workspace.base %>/<%= section %>"><%= section[0].toUpperCase() + section.slice(1) %></a><span class="breadcrumb-slash">/</span><strong><%= record ? "Edit" : "Create" %></strong></div><div class="topbar-right"><span class="role-pill"><%= user.role %></span></div></header>
            <section class="page-content">
                <div class="page-heading"><div><span class="eyebrow"><%= record ? "UPDATE RECORD" : "NEW RECORD" %></span><h1><%= record ? "Edit" : "Create" %> <%= section === "items" ? "catalog item" : section === "stages" ? "production stage" : section === "users" ? "team account" : section.slice(0, -1) %></h1><p>Enter the details below and save your changes.</p></div></div>
                <% if (error) { %><p class="notice error-notice" role="alert"><%= error %></p><% } %>
                <% if (record?.locked) { %><p class="notice error-notice">This order has production history and its details cannot be edited.</p><% } %>
                <section class="panel form-panel"><form class="modal-form" method="post" action="<%= workspace.base %>/<%= section %><%= record ? `/${record._id}` : "" %>">
                    <% if (section === "customers") { %>
                        <div class="form-grid"><label>Customer name<input name="name" maxlength="120" value="<%= record?.name || '' %>" required></label><label>Contact person<input name="contactPersonName" maxlength="120" value="<%= record?.contactPersonName || '' %>"></label></div>
                        <div class="form-grid"><label>Mobile<input name="mobile" type="tel" maxlength="30" value="<%= record?.mobile || '' %>"></label><label>Email<input name="email" type="email" maxlength="254" value="<%= record?.email || '' %>"></label></div>
                        <label>Address<textarea name="address" maxlength="500" rows="3"><%= record?.address || '' %></textarea></label>
                    <% } else if (section === "items") { %>
                        <div class="form-grid"><label>Part code<input name="partCode" maxlength="80" value="<%= record?.partCode || '' %>" required></label><label>Variant<input name="variant" maxlength="120" value="<%= record?.variant || '' %>"></label></div>
                        <label>Description<textarea name="description" maxlength="500" rows="3" required><%= record?.description || '' %></textarea></label>
                    <% } else if (section === "stages") { %>
                        <label>Process name<input name="processName" maxlength="120" value="<%= record?.processName || '' %>" required></label>
                    <% } else if (section === "orders") { %>
                        <% if (record?.locked) { %>
                            <label>Order status<select name="status"><option value="OPEN" <%= record.status === "OPEN" ? "selected" : "" %>>Open</option><option value="ON_HOLD" <%= record.status === "ON_HOLD" ? "selected" : "" %>>On hold</option></select></label>
                        <% } else { %>
                        <div class="form-grid"><label>PO number<input name="poNo" maxlength="80" value="<%= record?.poNo || '' %>" required></label>
                            <label>Customer<select name="customer" required><option value="">Choose customer</option><% customers.forEach((customer) => { %><option value="<%= customer._id %>" <%= record && recordId(record.customer) === String(customer._id) ? "selected" : "" %>><%= customer.customerUid %> — <%= customer.name %></option><% }) %></select></label></div>
                        <label>Item<select name="item" required><option value="">Choose item</option><% items.forEach((item) => { %><option value="<%= item._id %>" <%= record && recordId(record.item) === String(item._id) ? "selected" : "" %>><%= item.partCode %> — <%= item.description %></option><% }) %></select></label>
                        <div class="form-grid"><label>Quantity (pcs)<input name="qtyPcs" type="number" min="0" step="any" value="<%= record?.qtyPcs ?? 0 %>" required></label><label>Quantity (kg)<input name="qtyKgs" type="number" min="0" step="any" value="<%= record?.qtyKgs ?? 0 %>" required></label></div>
                        <label>Delivery date<input name="deliveryDate" type="date" value="<%= formatDate(record?.deliveryDate) %>" required></label>
                        <% if (record) { %><label>Order status<select name="status"><option value="OPEN" <%= record.status === "OPEN" ? "selected" : "" %>>Open</option><option value="ON_HOLD" <%= record.status === "ON_HOLD" ? "selected" : "" %>>On hold</option></select></label><% } %>
                        <fieldset class="permission-editor"><legend>Production route</legend><p class="form-help">Choose a unique position for each required stage. Leave unused stages unselected.</p>
                            <% stages.forEach((stage) => { const currentIndex = record?.productionStages?.findIndex((entry) => recordId(entry) === String(stage._id)) ?? -1; %>
                                <label class="route-stage"><span><%= stage.processName %></span><select name="stageOrder_<%= stage._id %>"><option value="">Not required</option><% for (let i = 1; i <= stages.length; i++) { %><option value="<%= i %>" <%= currentIndex === i - 1 ? "selected" : "" %>><%= i %></option><% } %></select></label>
                            <% }) %>
                        </fieldset>
                        <% } %>
                    <% } else if (section === "ledger") { %>
                        <% if (orders.length) { %><label>Order and next stage<select name="nextStage" required><option value="">Choose order and stage</option><% orders.forEach((order) => { %><option value="<%= order._id %>|<%= order.nextStage._id %>"><%= order.poNo %> — <%= order.customer?.name || "Customer" %> · <%= order.nextStage.processName %></option><% }) %></select></label>
                        <div class="form-grid"><label>Processed quantity (pcs)<input name="qtyPcs" type="number" min="0" step="any" value="0" required></label><label>Processed quantity (kg)<input name="qtyKgs" type="number" min="0" step="any" value="0" required></label></div>
                        <p class="form-help">The next configured production stage is selected for each order. The timestamp is recorded automatically.</p>
                        <% } else { %><p class="empty-state">No orders are waiting for a production update.</p><% } %>
                    <% } else if (section === "users") { %>
                        <div class="form-grid"><% if (record) { %><label>Username<input value="<%= record.username %>" readonly></label><% } else { %><label>Username<input name="username" minlength="3" maxlength="64" required></label><% } %><label>Role<select name="role" id="role-select" data-default-permissions="<%= JSON.stringify(defaultPermissions) %>"><% ["CRM", "EXECUTIVE", "ADMIN"].forEach((role) => { %><option value="<%= role %>" <%= (record?.role || "CRM") === role ? "selected" : "" %>><%= role %></option><% }) %></select></label></div>
                        <% if (record) { %><label>Account status<select name="isActive"><option value="true" <%= record.isActive ? "selected" : "" %>>Active</option><option value="false" <%= !record.isActive ? "selected" : "" %>>Inactive</option></select></label><% } else { %><label>Temporary password (12+ characters)<input name="password" type="password" minlength="12" autocomplete="new-password" required></label><% } %>
                        <fieldset class="permission-editor"><legend>Permissions</legend><p class="form-help">Role changes start from that role’s default access. You can customize the permissions below.</p>
                            <% permissionGroups.forEach((group) => { %><div class="permission-group"><strong><%= group.label %></strong><div class="permission-options"><% group.values.forEach(([value, label]) => { %><label class="permission-option"><input type="checkbox" name="permissions" value="<%= value %>" data-role-permission <%= selectedPermissions.includes(value) ? "checked" : "" %>><%= label %></label><% }) %></div></div><% }) %>
                        </fieldset>
                    <% } %>
                    <div class="modal-actions"><a class="button button-secondary" href="<%= workspace.base %>/<%= section %>">Cancel</a><button class="button button-primary" type="submit"<%= section === "ledger" && !orders.length ? " disabled" : "" %>>Save changes</button></div>
                </form></section>
            </section>
        </main>
    </div>
    <script src="/scripts/pages.js" defer></script>
</body>
</html>
